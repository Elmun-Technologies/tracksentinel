{
  "name": "tracksentinel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "db:generate": "pnpm --filter @tracksentinel/db generate",
    "db:migrate": "pnpm --filter @tracksentinel/db migrate",
    "db:push": "pnpm --filter @tracksentinel/db push"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
