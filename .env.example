# Database (self-hosted PostgreSQL)
DATABASE_URL=postgresql://tracksentinel:changeme@localhost:5432/tracksentinel

# NextAuth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-32-char-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_SECRET=random-secret-string

# Email (Resend)
RESEND_API_KEY=re_your-api-key

# Error Tracking (Sentry)
SENTRY_DSN=https://your-sentry-dsn

# Internal worker authentication
WORKER_INTERNAL_SECRET=random-long-secret

# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://app.tracksentinel.com
